@model List<ResultResponse>
@{ ViewData["Title"] = "My results"; }
<p class="eyebrow">EVERY FINISH LINE TELLS A STORY</p>
<h1>My results</h1>
<p>Your personal race history. Results appear once your organiser publishes them.</p>
@if (Model.Count == 0) { <div class="card empty-state">
<h2>The best is still ahead.</h2>
<p>No results have been recorded for you yet. Check My events for your entries.</p>
<a asp-action="Events">View my events</a>
</div> }
else { <div class="table-responsive card">
<table class="table">
<caption>Official results recorded by your event organisers</caption>
<thead>
<tr>
<th>Event</th>
<th>Date</th>
<th>Category</th>
<th>Finish time</th>
<th>Position</th>
</tr>
</thead>
<tbody>
@foreach (var result in Model) { <tr>
<td>
<a asp-controller="Events" asp-action="Details" asp-route-id="@result.EventId">@result.EventName</a>
</td>
<td>@result.EventDate.ToString("dd MMM yyyy")</td>
<td>@result.CategoryName</td>
<td class="result-time">@result.FinishTime.ToString("HH:mm:ss")</td>
<td>
<strong>@result.FinishPosition</strong> out of @result.TotalFinishers recorded finishers</td>
</tr> }</tbody>
</table>
</div>
<p class="help-text">Positions are overall event positions; the finisher count increases as results are recorded.</p> }
