@model List<OrganiserEventResponse>
@if (Model.Count == 0) { <section class="empty-state card">
<h2>Your community is waiting.</h2>
<p>Create your first event, then add categories and a banner.</p>
<a asp-controller="Organiser" asp-action="Create">Create an event</a>
</section> }
else { <div class="table-responsive card">
<table class="table">
<caption>Your events, including completed races</caption>
<thead>
<tr>
<th>Event</th>
<th>Date</th>
<th>Entries</th>
<th>Manage</th>
</tr>
</thead>
<tbody>
@foreach(var item in Model) { <tr>
<td>
<a asp-controller="Events" asp-action="Details" asp-route-id="@item.Event.EventId">@item.Event.EventName</a>
<small class="d-block">@item.Event.City · @item.Event.DistanceKm.ToString("0.#") km</small>
</td>
<td>@item.Event.EventDate.ToString("dd MMM yyyy")</td>
<td>@item.TotalEnrolments</td>
<td>
<div class="action-links">
<a asp-controller="Organiser" asp-action="Edit" asp-route-id="@item.Event.EventId">Edit</a>
<a asp-controller="Organiser" asp-action="Categories" asp-route-id="@item.Event.EventId">Categories</a>
<a asp-controller="Organiser" asp-action="Enrolments" asp-route-id="@item.Event.EventId">Entries &amp; results</a>
<a asp-controller="Organiser" asp-action="Delete" asp-route-id="@item.Event.EventId">Delete</a>
</div>
</td>
</tr> }</tbody>
</table>
</div> }
