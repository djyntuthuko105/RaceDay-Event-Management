@model EventResponse
<article class="event-card"><div class="event-art art-@Model.EventType.ToLowerInvariant()"><span class="sport-tag">@Model.EventType</span><span class="distance-mark">@Model.DistanceKm.ToString("0.#")<small>KM</small></span></div><div class="event-card-content"><p class="event-meta">@Model.EventDate.ToString("dd MMM yyyy") · @Model.City</p><h3><a asp-controller="Events" asp-action="Details" asp-route-id="@Model.EventId">@Model.EventName</a></h3><p>@Model.VenueName</p><div class="card-bottom"><span>@Model.Province</span><a asp-controller="Events" asp-action="Details" asp-route-id="@Model.EventId">View event <span aria-hidden="true">→</span></a></div></div></article>
