<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · RaceDay</title>
    <link rel="stylesheet" href="~/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<a class="skip-link" href="#main">Skip to content</a>
<header class="site-header">
    <a class="brand" asp-controller="Events" asp-action="Index">RACE<span>DAY</span><small>FIND YOUR NEXT START LINE.</small></a>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="main-nav">Menu</button>
    <nav id="main-nav" aria-label="Main navigation">
        <a asp-controller="Events" asp-action="Index">Explore events</a>
        <a asp-controller="Account" asp-action="Login">Log in</a>
        <a class="btn btn-primary" asp-controller="Account" asp-action="Register">Join RaceDay</a>
    </nav>
</header>
<main id="main" class="page-shell">
    @if (TempData["Success"] is string success) { <div class="notice success" role="status">@success</div> }
    @if (TempData["Error"] is string error) { <div class="notice danger" role="alert">@error</div> }
    @RenderBody()
</main>
<footer class="site-footer"><strong>RACEDAY</strong><span>Run. Walk. Cycle. Your next chapter starts here.</span><span>Built for South Africa.</span></footer>
<script src="~/js/site.js" asp-append-version="true" defer></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
