@using RaceDay.Web.Security
@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    var role = Context.Session.GetString(WebSession.Role);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · RaceDay</title>
    <link rel="icon" type="image/svg+xml" href="~/images/favicon.svg" />
    <link rel="stylesheet" href="~/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<a class="skip-link" href="#main">Skip to content</a>
<header class="site-header">
    <a class="brand" asp-controller="Events" asp-action="Index" aria-label="RaceDay home">
        <img src="~/images/favicon.svg" alt="" width="40" height="40" />
        <span class="brand-name">RACE<b>DAY</b><small>FIND YOUR NEXT START LINE.</small></span>
    </a>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="main-nav">Menu</button>
    <nav id="main-nav" aria-label="Main navigation">
        <a asp-controller="Events" asp-action="Index" aria-current="@(controller == "Events" ? "page" : null)">Explore events</a>
        @if (Context.Session.GetInt32(WebSession.UserId) is not null)
        {
            @if (Context.Session.GetString(WebSession.Role) == "Organiser")
            { <a asp-controller="Organiser" asp-action="Index" aria-current="@(controller == "Organiser" && action == "Index" ? "page" : null)">Dashboard</a>
<a asp-controller="Organiser" asp-action="Events" aria-current="@(controller == "Organiser" && action == "Events" ? "page" : null)">Manage events</a> }
            else
            { <a asp-controller="Participant" asp-action="Events" aria-current="@(controller == "Participant" && action == "Events" ? "page" : null)">My events</a>
<a asp-controller="Participant" asp-action="Results" aria-current="@(controller == "Participant" && action == "Results" ? "page" : null)">My results</a> }
            <a asp-controller="Profile" asp-action="Index" aria-current="@(controller == "Profile" && action == "Index" ? "page" : null)">Profile</a>
            <span class="account-label"><strong>@Context.Session.GetString(WebSession.Name)</strong><small>@role workspace</small></span>
            <form asp-controller="Account" asp-action="Logout" method="post">
<button class="btn btn-outline-dark" type="submit">Log out</button>
</form>
        }
        else
        {
            <a asp-controller="Account" asp-action="Login">Log in</a>
            <a class="btn btn-primary" asp-controller="Account" asp-action="Register">Join RaceDay</a>
        }
    </nav>
</header>
<main id="main" class="page-shell" tabindex="-1">
    @if (TempData["Success"] is string success) { <div class="notice success" role="status">@success</div> }
    @if (TempData["Error"] is string error) { <div class="notice danger" role="alert">@error</div> }
    @RenderBody()
</main>
<footer class="site-footer">
<strong>RACEDAY</strong>
<span>Run. Walk. Cycle. Your next chapter starts here.</span>
<span>Built for South Africa.</span>
</footer>
<script src="~/js/site.js" asp-append-version="true" defer>
</script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
